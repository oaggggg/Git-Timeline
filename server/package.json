{
  "name": "git-timeline-server",
  "version": "1.0.0",
  "description": "Backend service for Git Timeline Viewer",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others-on-fail \"tsc --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
